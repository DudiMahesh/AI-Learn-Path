# ── Flask ────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here

# ── Database (Neon PostgreSQL recommended for Render) ────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── Groq LLM (Free API) ──────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b

# ── Embeddings ───────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Database ──────────────────────────────────────
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./rag/chroma_db

# ── CORS — set to your Vercel frontend URL ───────────────
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend-*.vercel.app

# ── Admin Credentials ────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your-secure-admin-password

